{
  "format": "portraius.preset",
  "version": 1,
  "id": "product-swap",
  "type": "recast",
  "title": "Product swap",
  "author": "portraius-studio",
  "license": "CC0-1.0",
  "recipe": {
    "capability": "video.edit",
    "model": "kling/kling-v3-omni",
    "slots": [
      {
        "slot": "prop",
        "kind": "element"
      }
    ],
    "prompt": "Replace the product held in <<<video_1>>> with the {prop} in <<<image_1>>>. Keep the hands, the motion and everything else unchanged.",
    "params": {
      "mode": "swap",
      "target": "product"
    }
  }
}
