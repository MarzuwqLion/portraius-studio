{
  "name": "portraius-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p proxy/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "shots": "tsx scripts/shots.ts",
    "thumbnails": "tsx scripts/thumbnails.ts",
    "gen:schemas": "tsx scripts/gen-schema-types.ts",
    "proxy:dev": "wrangler dev -c proxy/wrangler.jsonc",
    "proxy:deploy": "wrangler deploy -c proxy/wrangler.jsonc",
    "presets:check": "tsx scripts/presets-check.ts",
    "voices:check": "tsx scripts/voices-check.ts",
    "workflows": "vitest run src/lib/workflows --mode workflows",
    "workflows:check": "tsx scripts/workflows-check.ts",
    "nodepack": "vitest run src/lib/nodepack --mode nodepack"
  },
  "dependencies": {
    "@comfyorg/sdk": "^0.5.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tanstack/react-query": "^5.104.4",
    "@vladmandic/face-api": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@ffmpeg/core": "^0.12.10",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
